# Copie para .env e preencha.

# Base de dados PostgreSQL.
# Local: as duas variáveis podem ter o mesmo valor.
# Supabase: ver DEPLOY.md (DATABASE_URL = pooler porta 6543, DIRECT_URL = pooler porta 5432).
DATABASE_URL="postgresql://contratos:contratos@localhost:5432/contratos"
DIRECT_URL="postgresql://contratos:contratos@localhost:5432/contratos"

# Administrador inicial, criado por `npm run db:seed` se ainda não existir nenhum.
ADMIN_EMAIL="admin@empresa.pt"
ADMIN_PASSWORD="mude-esta-password"
